rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- кӣ кист ----------
    function signed() { return request.auth != null; }
    function isOwner() {
      return signed() && request.auth.token.email_verified == true
        && request.auth.token.email in ['umar.safaroov@gmail.com'];
    }
    function isAdmin() {
      return isOwner() || (signed() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }
    function isWorker() { return signed() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function wid() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.wid; }
    function hasSession() { return signed() && exists(/databases/$(database)/documents/sessions/$(request.auth.uid)); }
    function myCid() { return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.cid; }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- танзимоти ширкат (ҳама мехонанд, танҳо роҳбар менависад) ----------
    match /settings/{d} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- роҳбарон (танҳо соҳиб илова ё хориҷ мекунад) ----------
    match /admins/{e} {
      allow read: if isAdmin() || (signed() && request.auth.token.email != null && request.auth.token.email.lower() == e);
      allow write: if isOwner();
    }

    // ---------- коргарон ----------
    match /workers/{w} {
      allow read: if isAdmin() || isWorker();
      allow write: if isAdmin();
    }
    match /staff/{uid} {
      allow read: if isAdmin() || (signed() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ---------- муштариён ----------
    match /sessions/{uid} {
      allow read, delete: if isAdmin() || (signed() && request.auth.uid == uid);
      allow create, update: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cid', 't'])
        && request.resource.data.cid is string;
    }
    match /customers/{c} {
      allow read: if isAdmin() || (hasSession() && myCid() == c);
      allow create: if isAdmin() || (signed() && request.resource.data.keys().hasOnly(['name', 'phone', 'createdAt']));
      allow update, delete: if isAdmin();
    }

    // ---------- дархостҳо (нархи харид дар ин ҷо нест) ----------
    match /requests/{r} {
      function mineW(d) { return isWorker() && d.workerId == wid(); }
      function openW(d) { return isWorker() && d.workerId == null && d.status == 'assigned'; }
      function mineC(d) { return hasSession() && d.customerId == myCid(); }
      function mineO(d) { return isWorker() && d.orderWorkerId == wid(); }

      allow read: if isAdmin() || mineW(resource.data) || openW(resource.data) || mineO(resource.data) || mineC(resource.data);

      allow create: if isAdmin()
        || (hasSession() && request.resource.data.customerId == myCid()
            && request.resource.data.status == 'new' && request.resource.data.workerId == null);

      allow update: if isAdmin()
        || ((mineW(resource.data) || openW(resource.data))
            && request.resource.data.workerId == wid()
            && onlyKeys(['workerId', 'status', 'assignedAt', 'foundAt', 'photos', 'updatedAt', 'log'])
            && request.resource.data.status in ['assigned', 'searching', 'found', 'notfound'])
        || (mineO(resource.data)
            && request.resource.data.orderWorkerId == resource.data.orderWorkerId
            && onlyKeys(['ordStage', 'status', 'cargo', 'tracking', 'shippedAt', 'photos', 'updatedAt', 'log'])
            && request.resource.data.status in ['ordered', 'shipped'])
        || (mineC(resource.data)
            && onlyKeys(['custOff', 'status', 'orderedAt', 'updatedAt', 'log'])
            && (request.resource.data.status == resource.data.status
                || (resource.data.status == 'offered' && request.resource.data.status in ['ordered', 'cancelled'])
                || (resource.data.status in ['new', 'assigned'] && request.resource.data.status == 'cancelled')));

      allow delete: if isAdmin();
    }

    // ---------- нархи харид, паставшикҳо (муштарӣ намебинад) ----------
    match /priv/{r} {
      function reqDoc() { return get(/databases/$(database)/documents/requests/$(r)).data; }
      allow read: if isAdmin() || (isWorker() && (resource.data.workerId == wid() || resource.data.orderWorkerId == wid()));
      allow create, update: if isAdmin()
        || (isWorker() && reqDoc().workerId == wid() && request.resource.data.workerId == wid());
      allow delete: if isAdmin();
    }

    // ---------- аксҳо ----------
    match /photos/{p} {
      allow read: if isAdmin() || isWorker() || (hasSession() && resource.data.cid == myCid());
      allow create: if (isAdmin() || isWorker() || (hasSession() && request.resource.data.cid == myCid()))
        && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow delete: if isAdmin();
    }
  }
}
